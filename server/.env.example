# Local PostgreSQL. Never commit the real .env file.
PGHOST=localhost
PGPORT=5432
PGDATABASE=short_url
PGUSER=postgres
PGPASSWORD=replace-with-your-local-password
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000

# Hosting: set DATABASE_URL instead of the PG* variables.
# Use the provider's connection string, including its required SSL settings.
# DATABASE_URL=postgresql://user:password@host:5432/database
# PUBLIC_BASE_URL=https://your-app.onrender.com
