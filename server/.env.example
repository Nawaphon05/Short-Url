# Local PostgreSQL. Never commit the real .env file.
PGHOST=localhost
PGPORT=5432
PGDATABASE=short_url
PGUSER=postgres
PGPASSWORD=replace-with-your-local-password
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000

# Hosting: set DATABASE_URL instead of the PG* variables.
# Use the provider's connection string, including its required SSL settings.
# DATABASE_URL=postgresql://user:password@host:5432/database
# PUBLIC_BASE_URL=https://your-app.onrender.com

# Optional: enable separate Redirect service. Leave URL unset for local rollback mode.
# REDIRECT_SERVICE_URL=http://localhost:3001
# REDIRECT_SERVICE_TOKEN=replace-with-generated-random-token
# REDIRECT_SERVICE_TIMEOUT_MS=70000
# Optional browser handoff for free hosting; deploy the service public /r route first.
# REDIRECT_SERVICE_MODE=browser
