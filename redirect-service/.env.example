# Copy to .env only for local development. Never commit actual credentials.
PGHOST=localhost
PGPORT=5432
PGDATABASE=short_url
PGUSER=postgres
PGPASSWORD=replace-with-your-local-password
PORT=3001
# Generate a random token and use the SAME value in server/.env.
REDIRECT_SERVICE_TOKEN=replace-with-generated-random-token
# Hosting: use DATABASE_URL in the Render Environment dashboard.
# DATABASE_URL=postgresql://user:password@host:5432/database
